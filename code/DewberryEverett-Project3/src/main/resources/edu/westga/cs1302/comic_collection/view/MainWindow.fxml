<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="368.0" prefWidth="316.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.comic_collection.view.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TextField fx:id="comicNameField" layoutX="29.0" layoutY="84.0" promptText="Name here" />
      <Button fx:id="addButton" layoutX="28.0" layoutY="334.0" mnemonicParsing="false" text="Add" />
      <ListView fx:id="comicCollection" layoutX="29.0" layoutY="122.0" prefHeight="200.0" prefWidth="200.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" text="Remove Collection" fx:id="contextRemove"/>
              </items>
            </ContextMenu>
         </contextMenu>
      </ListView>
      <Button fx:id="removeButton" layoutX="78.0" layoutY="334.0" mnemonicParsing="false" text="Remove" />
      <Label layoutX="28.0" layoutY="59.0" text="Comic Name" />
   </children>
</AnchorPane>
