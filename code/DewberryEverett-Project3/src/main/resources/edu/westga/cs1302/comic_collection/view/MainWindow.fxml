<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="410.0" prefWidth="521.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.comic_collection.view.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TextField fx:id="collectionNameField" layoutX="29.0" layoutY="84.0" promptText="Name here" />
      <Button fx:id="addCollectionButton" layoutX="20.0" layoutY="349.0" mnemonicParsing="false" text="Add Collection" />
      <ListView fx:id="comicCollectionList" layoutX="29.0" layoutY="137.0" prefHeight="200.0" prefWidth="200.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem fx:id="contextRemoveCollection" mnemonicParsing="false" text="Remove Collection" />
              </items>
            </ContextMenu>
         </contextMenu>
      </ListView>
      <Button fx:id="removeCollectionButton" layoutX="121.0" layoutY="349.0" mnemonicParsing="false" text="Remove Collection" />
      <Label layoutX="28.0" layoutY="59.0" text="Collection Name" />
      <Label layoutX="28.0" layoutY="120.0" text="Collections" />
      <ListView fx:id="comicList" layoutX="309.0" layoutY="137.0" prefHeight="200.0" prefWidth="200.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem fx:id="contextRemoveComic" mnemonicParsing="false" text="Remove Comic" />
              </items>
            </ContextMenu>
         </contextMenu>
      </ListView>
      <Label layoutX="309.0" layoutY="120.0" text="Comics" />
      <Button fx:id="addComicButton" layoutX="309.0" layoutY="349.0" mnemonicParsing="false" text="Add Comic" />
      <Button fx:id="removeComicButton" layoutX="390.0" layoutY="349.0" mnemonicParsing="false" text="Remove Comic" />
      <Label layoutX="309.0" layoutY="23.0" text="Find a Comic" />
      <TextField fx:id="searchBar" layoutX="310.0" layoutY="41.0" />
      <Button fx:id="searchButton" layoutX="460.0" layoutY="41.0" mnemonicParsing="false" text="Search" />
   </children>
</AnchorPane>
