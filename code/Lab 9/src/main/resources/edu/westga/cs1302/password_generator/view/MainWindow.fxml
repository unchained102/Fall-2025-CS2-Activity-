<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="411.0" prefWidth="290.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.password_generator.view.MainWindow">
   <children>
      <MenuBar layoutY="2.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
                  <MenuItem fx:id="fileAbout" mnemonicParsing="false" text="About" />
                  <MenuItem fx:id="fileSave" mnemonicParsing="false" text="Save" />
              <MenuItem fx:id="fileClose" mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <CheckBox fx:id="mustIncludeDigits" layoutX="50.0" layoutY="78.0" mnemonicParsing="false" text="Must Include Digits" />
      <CheckBox fx:id="mustIncludeLowerCaseLetters" layoutX="50.0" layoutY="108.0" mnemonicParsing="false" text="Must Include Lower Case Letters" />
      <CheckBox fx:id="mustIncludeUpperCaseLetters" layoutX="50.0" layoutY="139.0" mnemonicParsing="false" text="Must Include Upper Case Letters" />
      <Button fx:id="generatePasswordButton" layoutX="82.0" layoutY="183.0" mnemonicParsing="false" text="Generate Password" />
      <TextField fx:id="minimumLength" layoutX="154.0" layoutY="29.0" prefHeight="25.0" prefWidth="41.0" />
      <Label layoutX="50.0" layoutY="33.0" text="Minimum Length" />
      <Label fx:id="errorTextLabel" layoutX="45.0" layoutY="151.0" prefHeight="17.0" prefWidth="199.0" textFill="RED" />
      <ListView fx:id="passwordHistory" layoutX="45.0" layoutY="212.0" prefHeight="169.0" prefWidth="200.0" />
      <Label fx:id="minLengthErrorText" layoutX="76.0" layoutY="54.0" text="Must be a positive integer" textFill="RED" visible="false" />
   </children>
</AnchorPane>
