<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.Project1.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <AnchorPane>
         <children>
            <Label text="New Task Name" />
            <TextField fx:id="nameField" layoutY="40.0" />
            <Label layoutY="80.0" text="New Task Description" />
            <TextArea fx:id="descriptionBox" layoutY="120.0" prefHeight="180.0" prefWidth="200.0" />
            <Label layoutY="320.0" text="New Task Priority" />
            <ComboBox fx:id="priorityBox" layoutY="360.0" prefWidth="150.0" promptText="Priority" visibleRowCount="10" />
            <Button fx:id="submitButton" layoutX="190.0" layoutY="360.0" mnemonicParsing="false" onAction="#submitPressed" text="Add Task to List" />
            <ListView fx:id="taskList" layoutX="260.0" layoutY="40.0" onMouseClicked="#taskSelected" prefHeight="180.0" prefWidth="200.0" />
            <Label layoutX="260.0" text="Task List" />
            <Label layoutX="640.0" />
            <Label layoutX="520.0" text="Selected Name" />
            <TextField id="selectedNameField" fx:id="selectedNameField" editable="false" layoutX="520.0" layoutY="40.0" text="No Task Selected" />
            <TextArea fx:id="selectedDescription" editable="false" layoutX="520.0" layoutY="120.0" prefHeight="180.0" prefWidth="200.0" />
            <Label layoutX="520.0" layoutY="80.0" text="Selected Description" />
            <Label layoutX="520.0" layoutY="320.0" text="Selected Priority" />
            <TextField fx:id="selectedPriority" editable="false" layoutX="520.0" layoutY="360.0" />
         </children>
      </AnchorPane>
   </children>
</VBox>
